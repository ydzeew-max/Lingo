<Window x:Class="Lingo.ImageTranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Перевод фото — Lingo"
        Height="640" Width="920"
        MinHeight="460" MinWidth="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        Icon="icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <!-- Outer Drop Shadow -->
    <Border Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <!-- Main Frame with Smooth Rounded Corners & Modern Charcoal Glass -->
        <Border x:Name="MainRootBorder"
                Background="{StaticResource WindowBg}"
                BorderBrush="{StaticResource WindowBorder}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WindowScale" ScaleX="0.97" ScaleY="0.97" />
                    <TranslateTransform x:Name="WindowTranslate" Y="8" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.RenderTransformOrigin>
                <Point X="0.5" Y="0.5" />
            </Border.RenderTransformOrigin>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" /> <!-- Header -->
                    <RowDefinition Height="*" />  <!-- Image Viewport -->
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->
                <Grid Grid.Row="0" Margin="18,0,18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="20" Height="20" Margin="0,0,10,0">
                            <Path Data="M 3 3 L 3 17 L 14 17 M 10 13 L 14 17 L 10 21" 
                                  Stroke="{StaticResource AccentBrush}" 
                                  StrokeThickness="2.3" 
                                  StrokeLineJoin="Round" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock Text="LINGO" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text=" • Фотоперевод" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Translation Engine Dropdown in Header -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="Translate" Width="14" Height="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="EngineCombo" 
                                  Width="190" Height="28" 
                                  FontSize="12"
                                  Style="{StaticResource PillComboBoxStyle}" 
                                  SelectionChanged="EngineCombo_SelectionChanged">
                            <ComboBoxItem Content="Google Translate" Tag="Google" IsSelected="True"/>
                            <ComboBoxItem Content="Яндекс.Переводчик" Tag="Yandex"/>
                            <ComboBoxItem Content="Офлайн (Локальная база)" Tag="Offline"/>
                            <ComboBoxItem Content="Автовыбор (Smart Auto)" Tag="Auto"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Titlebar Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click" ToolTip="Свернуть">
                            <materialDesign:PackIcon Kind="Minus" Width="16" Height="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="Maximize_Click" ToolTip="Развернуть" Margin="4,0,0,0">
                            <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="CropSquare" Width="15" Height="15" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="Close_Click" ToolTip="Закрыть" Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= IMAGE VIEWPORT & OVERLAY ================= -->
                <Border Grid.Row="1" Background="#161616" CornerRadius="0,0,11,11" ClipToBounds="True">
                    <Grid x:Name="ViewportGrid" 
                          Background="Transparent"
                          SizeChanged="ViewportGrid_SizeChanged"
                          MouseWheel="ViewportGrid_MouseWheel"
                          PreviewMouseDown="ViewportGrid_PreviewMouseDown"
                          PreviewMouseMove="ViewportGrid_PreviewMouseMove"
                          PreviewMouseUp="ViewportGrid_PreviewMouseUp">

                        <!-- Main Image Container with Interactive Zoom & Pan Transforms -->
                        <Grid x:Name="ImageContainerGrid" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center" 
                              RenderTransformOrigin="0.5,0.5"
                              TextOptions.TextFormattingMode="Ideal"
                              TextOptions.TextRenderingMode="ClearType"
                              RenderOptions.BitmapScalingMode="HighQuality">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                                    <TranslateTransform x:Name="ImageTranslateTransform" X="0" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Base Image -->
                            <Image x:Name="MainImageDisplay" 
                                   Stretch="Fill" 
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <!-- Overlay Canvas for In-Place Text Replacement Blocks -->
                            <Canvas x:Name="OverlayCanvas" 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Top"
                                    TextOptions.TextFormattingMode="Ideal"
                                    TextOptions.TextRenderingMode="ClearType"
                                    TextOptions.TextHintingMode="Auto"
                                    RenderOptions.ClearTypeHint="Enabled" />
                        </Grid>

                        <!-- Loading Progress Overlay with Aesthetic Laser Beam Scanning Effect (No Text) -->
                        <Border x:Name="LoadingOverlay" 
                                Background="#45000000" 
                                CornerRadius="0,0,11,11"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <Grid>
                                <!-- Center Aesthetic Pulsing Radar Core (Zero Text) -->
                                <Grid Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Outer Pulsing Ring -->
                                    <Ellipse x:Name="PulseRing" Width="46" Height="46" 
                                             Stroke="{StaticResource AccentBrush}" StrokeThickness="2" 
                                             Opacity="0.7" 
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="PulseScale" ScaleX="1.0" ScaleY="1.0" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                                                         From="0.8" To="1.55" Duration="0:0:1.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                                                         From="0.8" To="1.55" Duration="0:0:1.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity"
                                                                         From="0.8" To="0.0" Duration="0:0:1.25" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>

                                    <!-- Center Core Badge with Glow -->
                                    <Border Width="40" Height="40" Background="#E61A2B3D" CornerRadius="20" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" Color="#60CDFF" Opacity="0.55" ShadowDepth="0" />
                                        </Border.Effect>
                                        <materialDesign:PackIcon Kind="AutoFix" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" 
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Sweeping Laser Scan Line -->
                                <Border Height="3" VerticalAlignment="Top" HorizontalAlignment="Stretch" RenderTransformOrigin="0.5,0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0060CDFF" Offset="0.0" />
                                            <GradientStop Color="#CC60CDFF" Offset="0.25" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                            <GradientStop Color="#CC60CDFF" Offset="0.75" />
                                            <GradientStop Color="#0060CDFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Color="#60CDFF" Opacity="0.85" ShadowDepth="0" />
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="LaserTransform" Y="0" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="LaserTransform" Storyboard.TargetProperty="Y"
                                                                     From="15" To="520" Duration="0:0:1.6">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ================= FLOATING GLASSMORPHIC BOTTOM CONTROL BAR ================= -->
                        <Border HorizontalAlignment="Center" 
                                VerticalAlignment="Bottom" 
                                Margin="0,0,0,18"
                                Background="#D9202020" 
                                BorderBrush="#28FFFFFF" 
                                BorderThickness="1" 
                                CornerRadius="16" 
                                Padding="8,5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.55" Color="#000000" />
                            </Border.Effect>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                
                                <!-- Toggle Translation Overlay Button [👁] -->
                                <Button x:Name="ToggleModeBtn" 
                                        Width="32" Height="30" 
                                        Background="#18FFFFFF"
                                        Foreground="#FFFFFF"
                                        Cursor="Hand"
                                        Click="ToggleMode_Click" 
                                        ToolTip="Переключить: Перевод / Оригинал (клик)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <materialDesign:PackIcon x:Name="ToggleModeIcon" Kind="EyeOutline" Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>

                                <!-- Zoom Reset / Percent Indicator Button -->
                                <Button x:Name="ZoomResetBtn"
                                        Height="30"
                                        Background="Transparent"
                                        Foreground="{StaticResource TextSecondary}"
                                        BorderThickness="0"
                                        Padding="8,0"
                                        Margin="4,0,0,0"
                                        Cursor="Hand"
                                        Click="ZoomReset_Click" 
                                        ToolTip="Масштаб (клик для сброса 100%, колесико мыши — зум)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <TextBlock x:Name="txt" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" 
                                                           Foreground="{TemplateBinding Foreground}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    100%
                                </Button>

                                <!-- Vertical Divider -->
                                <Border Width="1" Height="18" Background="#1FFFFFFF" Margin="6,0,8,0" />

                                <!-- Language Selector Pill -->
                                <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="6,2" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Source Language (with Auto-detect) -->
                                        <ComboBox x:Name="SourceLangCombo" 
                                                  Width="130" Height="26" 
                                                  FontSize="12"
                                                  Style="{StaticResource PillComboBoxStyle}" 
                                                  SelectionChanged="Language_SelectionChanged" />

                                        <Button x:Name="SwapBtn" 
                                                Style="{StaticResource SwapButtonStyle}" 
                                                Width="28" Height="26" 
                                                Click="SwapLanguages_Click" 
                                                ToolTip="Поменять языки местами">
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="14" Height="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Target Language -->
                                        <ComboBox x:Name="TargetLangCombo" 
                                                  Width="110" Height="26" 
                                                  FontSize="12"
                                                  Style="{StaticResource PillComboBoxStyle}" 
                                                  SelectionChanged="Language_SelectionChanged" />
                                    </StackPanel>
                                </Border>

                                <!-- Vertical Divider -->
                                <Border Width="1" Height="18" Background="#1FFFFFFF" Margin="0,0,8,0" />

                                <!-- Quick Action: Speak All Translated Text -->
                                <Button x:Name="SpeakAllBtn"
                                        Style="{StaticResource TitleBarButtonStyle}" 
                                        Width="32" Height="30" 
                                        Margin="0,0,4,0"
                                        Click="SpeakAll_Click" 
                                        ToolTip="Озвучить переведенный текст (клик)">
                                    <materialDesign:PackIcon x:Name="SpeakAllIcon" Kind="VolumeHigh" Width="16" Height="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Quick Action: Copy All Text with animated checkmark -->
                                <Button Style="{StaticResource TitleBarButtonStyle}" 
                                        Width="32" Height="30" 
                                        Margin="0,0,4,0"
                                        Click="CopyAll_Click" 
                                        ToolTip="Скопировать весь переведенный текст">
                                    <materialDesign:PackIcon x:Name="CopyAllIcon" Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <materialDesign:PackIcon.RenderTransform>
                                            <ScaleTransform x:Name="CopyAllScale" ScaleX="1.0" ScaleY="1.0" />
                                        </materialDesign:PackIcon.RenderTransform>
                                    </materialDesign:PackIcon>
                                </Button>

                                <!-- Quick Action: New Screen Snip -->
                                <Button Style="{StaticResource TitleBarButtonStyle}" 
                                        Width="32" Height="30" 
                                        Click="NewSnip_Click" 
                                        ToolTip="Сделать новый снимок экрана">
                                    <materialDesign:PackIcon Kind="CameraOutline" Width="16" Height="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Border>
</Window>
