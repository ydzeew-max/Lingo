<Window x:Class="Lingo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Lingo"
        Height="276" Width="490"
        MinHeight="250" MinWidth="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Icon="icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <!-- Window Outer Drop Shadow Container (Windows 11 Elevation) -->
    <Border Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <!-- Main Dark Frame with Entrance Animation Transform -->
        <Border x:Name="MainRootBorder"
                Background="{StaticResource WindowBg}"
                BorderBrush="{StaticResource WindowBorder}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WindowScale" ScaleX="0.97" ScaleY="0.97" />
                    <TranslateTransform x:Name="WindowTranslate" Y="8" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.RenderTransformOrigin>
                <Point X="0.5" Y="0.5" />
            </Border.RenderTransformOrigin>
            
            <Grid Margin="16,12,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="Auto" /> <!-- Language Selector Bar -->
                    <RowDefinition Height="*" />    <!-- Content Cards -->
                </Grid.RowDefinitions>

                <!-- ================= HEADER TITLEBAR ================= -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="22" Height="22" Margin="2,0,8,0">
                            <Path Data="M 3 3 L 3 17 L 14 17 M 10 13 L 14 17 L 10 21" 
                                  Stroke="{StaticResource AccentBrush}" 
                                  StrokeThickness="2.4" 
                                  StrokeLineJoin="Round" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" />
                        </Grid>
                        
                        <TextBlock Text="LINGO" 
                                   Foreground="{StaticResource TextPrimary}" 
                                   FontWeight="Bold" 
                                   FontSize="14.5" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Status Notification Badges -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <!-- Offline Status Badge -->
                        <Border x:Name="OfflineStatusBadge"
                                Background="#382810"
                                BorderBrush="#80F59E0B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,3"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="WifiOff" Width="13" Height="13" Foreground="#F59E0B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OfflineStatusText" Text="Офлайн-словарь" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- OCR Status Badge -->
                        <Border x:Name="OcrStatusBadge"
                                Background="#162E40"
                                BorderBrush="#8060CDFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,3"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Image" Width="13" Height="13" Foreground="#60CDFF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OcrStatusText" Text="Распознавание..." Foreground="#60CDFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Custom Header Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Settings Gear Button -->
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="OpenSettings_Click" ToolTip="Настройки">
                            <materialDesign:PackIcon Kind="CogOutline" Width="17" Height="17" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Minimize Button -->
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click" ToolTip="Свернуть" Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="Minus" Width="17" Height="17" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource CloseButtonStyle}" Click="Close_Click" ToolTip="Закрыть" Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="Close" Width="17" Height="17" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= LANGUAGE SELECTOR BAR ================= -->
                <Border Grid.Row="1" 
                        Background="{StaticResource PillBg}" 
                        BorderBrush="{StaticResource PillBorder}" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="4,2" 
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Source Language -->
                        <ComboBox x:Name="SourceLangCombo" 
                                  Grid.Column="0" 
                                  Style="{StaticResource PillComboBoxStyle}" 
                                  SelectionChanged="Language_SelectionChanged" />

                        <!-- Swap Languages Button ⇄ -->
                        <Button x:Name="SwapButton" 
                                Grid.Column="1" 
                                Style="{StaticResource SwapButtonStyle}" 
                                Click="SwapLanguages_Click" 
                                ToolTip="Поменять языки местами">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Target Language -->
                        <ComboBox x:Name="TargetLangCombo" 
                                  Grid.Column="2" 
                                  Style="{StaticResource PillComboBoxStyle}" 
                                  SelectionChanged="Language_SelectionChanged" />
                    </Grid>
                </Border>

                <!-- ================= DUAL TRANSLATION CARDS ================= -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Input Text -->
                    <Border x:Name="InputCardBorder"
                            Grid.Column="0" 
                            Background="{StaticResource CardBg}" 
                            BorderBrush="{StaticResource CardBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12"
                            AllowDrop="True"
                            Drop="Card_Drop"
                            DragOver="Card_DragOver">
                        <Grid>
                            <TextBox x:Name="InputTextBox" 
                                     Background="Transparent" 
                                     Foreground="{StaticResource TextPrimary}" 
                                     BorderThickness="0" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True" 
                                     FontSize="13.5" 
                                     CaretBrush="{StaticResource AccentBrush}"
                                     TextChanged="InputTextBox_TextChanged"
                                     PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                     GotFocus="InputTextBox_GotFocus"
                                     LostFocus="InputTextBox_LostFocus"
                                     Text="Выделите текст и нажмите [Ctrl + Alt + T]..." />

                            <!-- Bottom Quick Action Buttons (TTS, Photo Translation & Clear) -->
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom">
                                <!-- Voice Input (Microphone) -->
                                <Button x:Name="VoiceInputButton" 
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Width="26" Height="26"
                                        Margin="0,0,4,0"
                                        Click="VoiceInput_Click" 
                                        ToolTip="Голосовой ввод (клик)">
                                    <materialDesign:PackIcon x:Name="VoiceInputIcon" Kind="Microphone" Width="15" Height="15" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Voice / TTS for Input Text -->
                                <Button x:Name="SpeakInputButton" 
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Width="26" Height="26"
                                        Margin="0,0,4,0"
                                        Click="SpeakInput_Click" 
                                        ToolTip="Озвучить исходный текст (клик)">
                                    <materialDesign:PackIcon x:Name="SpeakInputIcon" Kind="VolumeHigh" Width="15" Height="15" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Photo / Screen Snip Translation Button -->
                                <Button x:Name="PhotoSnipButton" 
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Width="26" Height="26"
                                        Click="PhotoSnip_Click" 
                                        ToolTip="Перевести с фото / Снимок экрана [Ctrl + Alt + S] (ПКМ — меню)">
                                    <materialDesign:PackIcon Kind="CameraOutline" Width="16" Height="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                                    <Button.ContextMenu>
                                        <ContextMenu Background="#FA262626" BorderBrush="#25FFFFFF" BorderThickness="1">
                                            <MenuItem Header="Сделать снимок экрана (Ctrl + Alt + S)" Click="PhotoSnip_Click">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="CameraOutline" Width="16" Height="16" Foreground="{StaticResource TextPrimary}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Вставить фото из буфера" Click="PasteImage_Click">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="ContentPaste" Width="16" Height="16" Foreground="{StaticResource TextPrimary}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Выбрать файл фото..." Click="OpenFile_Click">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="ImageOutline" Width="16" Height="16" Foreground="{StaticResource TextPrimary}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <!-- Clear Button -->
                                <Button x:Name="ClearButton" 
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Width="26" Height="26"
                                        Margin="4,0,0,0"
                                        Click="ClearInput_Click" 
                                        ToolTip="Очистить">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Card: Translated Output Text -->
                    <Border x:Name="OutputCardBorder"
                            Grid.Column="2" 
                            Background="{StaticResource CardBg}" 
                            BorderBrush="{StaticResource CardBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12">
                        <Grid>
                            <TextBox x:Name="OutputTextBox" 
                                     Background="Transparent" 
                                     Foreground="{StaticResource TextPrimary}" 
                                     BorderThickness="0" 
                                     TextWrapping="Wrap" 
                                     IsReadOnly="True" 
                                     FontSize="13.5" 
                                     Text="" />

                            <!-- Bottom Quick Action Buttons (TTS & Copy) -->
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom">
                                <!-- Voice / TTS for Output Translated Text -->
                                <Button x:Name="SpeakOutputButton" 
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Width="26" Height="26"
                                        Margin="0,0,4,0"
                                        Click="SpeakOutput_Click" 
                                        ToolTip="Озвучить перевод (клик)">
                                    <materialDesign:PackIcon x:Name="SpeakOutputIcon" Kind="VolumeHigh" Width="15" Height="15" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Quick Copy Button -->
                                <Button x:Name="CopyButton" 
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Width="26" Height="26"
                                        Click="CopyOutput_Click" 
                                        ToolTip="Копировать">
                                    <materialDesign:PackIcon x:Name="CopyIcon" Kind="ContentCopy" Width="14" Height="14" 
                                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                                             VerticalAlignment="Center"
                                                             RenderTransformOrigin="0.5,0.5">
                                        <materialDesign:PackIcon.RenderTransform>
                                            <ScaleTransform x:Name="CopyIconScale" ScaleX="1.0" ScaleY="1.0" />
                                        </materialDesign:PackIcon.RenderTransform>
                                    </materialDesign:PackIcon>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Border>
</Window>
