<Window x:Class="Lingo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Настройки Lingo"
        Height="365" Width="460"
        MinHeight="365" MaxHeight="365"
        MinWidth="460" MaxWidth="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <!-- Outer Drop Shadow -->
    <Border Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <!-- Main Settings Frame -->
        <Border Background="{StaticResource WindowBg}"
                BorderBrush="{StaticResource WindowBorder}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            
            <Grid Margin="18,14,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="*" />    <!-- Scrollable Content -->
                    <RowDefinition Height="Auto" /> <!-- Action Footer -->
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <TextBlock Text="Настройки" 
                                   Foreground="{StaticResource TextPrimary}" 
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- ================= SCROLLABLE CONTENT ================= -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                              Margin="0,0,0,12"
                              Padding="0,0,6,0">
                    <StackPanel>
                        
                        <!-- Card 1: Translation API Selection -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Движок перевода" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Выберите сервис для онлайн-перевода" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- ComboBox for Translation API selection -->
                                <ComboBox x:Name="TranslationApiCombo" 
                                          Grid.Column="1" 
                                          Width="195" Height="32" 
                                          Style="{StaticResource PillComboBoxStyle}" 
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="Google Translate" Tag="Google" IsSelected="True"/>
                                    <ComboBoxItem Content="Яндекс.Переводчик" Tag="Yandex"/>
                                    <ComboBoxItem Content="Офлайн (Локальная база)" Tag="Offline"/>
                                    <ComboBoxItem Content="Автовыбор (Smart Auto)" Tag="Auto"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Card 2: Hotkey Display -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Горячая клавиша" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Быстрый вызов окна Lingo" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Keycap Styled Badge -->
                                <Border Grid.Column="1" 
                                        Background="#18FFFFFF" 
                                        BorderBrush="#25FFFFFF" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="9,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="HotkeyText" 
                                               Text="Ctrl + Alt + T" 
                                               Foreground="{StaticResource TextPrimary}" 
                                               FontWeight="SemiBold" 
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 3: Automation & System Tray Settings -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <!-- Row 0: Always On Top -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Поверх всех окон" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Держать окно переводчика поверх других приложений" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <CheckBox x:Name="AlwaysOnTopCheck" 
                                              Grid.Column="1" 
                                              VerticalAlignment="Center" 
                                              Margin="0"
                                              ToolTip="Окно Lingo всегда находится на переднем плане" />
                                </Grid>

                                <!-- Divider line -->
                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,0,0,10" />

                                <!-- Row 1: Startup -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Автозагрузка" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Запускать Lingo вместе с Windows" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <CheckBox x:Name="StartWithWindowsCheck" 
                                              Grid.Column="1" 
                                              VerticalAlignment="Center" 
                                              Margin="0"
                                              ToolTip="Включить или выключить запуск с Windows" />
                                </Grid>

                                <!-- Divider line -->
                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,0,0,10" />

                                <!-- Row 2: Minimize to Tray on Close -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Сворачивать в трей" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Сворачивать в трей при нажатии на крестик" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <CheckBox x:Name="MinimizeToTrayCheck" 
                                              Grid.Column="1" 
                                              VerticalAlignment="Center" 
                                              Margin="0"
                                              ToolTip="При выключении крестик полностью закрывает приложение" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ================= ACTION FOOTER ================= -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Отмена" Click="Close_Click" Margin="0,0,10,0" Width="100" Height="32" Padding="0"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Сохранить" Click="Save_Click" Width="100" Height="32" Padding="0"/>
                </StackPanel>

            </Grid>
        </Border>
    </Border>
</Window>
